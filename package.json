{
  "name": "zeko-aaif-integration-work",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test integrations/id-jag/client.test.mjs tck/runner.test.mjs",
    "tck:validate": "node tck/run.mjs --validate",
    "tck:run": "node tck/run.mjs",
    "test:sandbox": "node sandbox/run.mjs test",
    "demo": "node sandbox/run.mjs demo",
    "demo:proofs": "node sandbox/run.mjs demo --proofs",
    "tck:idjag": "node sandbox/run.mjs tck --profile id-jag-mcp-v0.1 --adapter tck/adapters/id-jag-sandbox.mjs",
    "tck:proofs": "node sandbox/run.mjs tck --profile zeko-shared-state-v0.1 --adapter tck/adapters/shared-state-sandbox.mjs --timeout-ms 120000",
    "sandbox:evidence": "node sandbox/run.mjs evidence",
    "ecosystem:demo": "node sandbox/run.mjs ecosystem",
    "ecosystem:proofs": "node sandbox/run.mjs ecosystem --proofs",
    "ecosystem:setup": "node ecosystem/setup.mjs",
    "ecosystem:test:network": "node --test ecosystem/_shared/network.test.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@zeko/amba": "https://codeload.github.com/zeko-labs/agent-mission-bound-auth/tar.gz/4b5bb5c6915c7ee17e716ab2320e50d985dfc0d5",
    "ajv": "8.17.1",
    "express": "5.1.0",
    "jose": "6.1.3",
    "o1js": "2.13.0",
    "zod": "3.25.76"
  },
  "license": "Apache-2.0"
}
